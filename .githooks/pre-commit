#!/bin/sh
set -eu

git diff --cached --check

workspace=$PWD
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
trap 'exit 1' HUP INT TERM

git checkout-index --all --prefix="$snapshot/"

for dependencies in node_modules apps/client/node_modules apps/server/node_modules; do
  if [ -d "$workspace/$dependencies" ] && [ -d "$snapshot/${dependencies%node_modules}" ]; then
    ln -s "$workspace/$dependencies" "$snapshot/$dependencies"
  fi
done

cd "$snapshot"
npm run check:commit
